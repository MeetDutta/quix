# ==========================================
# EduQuizX Backend Supabase & App Config
# ==========================================

PROJECT_NAME="EduQuizX - AI Dynamic Examination System"
SECRET_KEY="super-secret-production-key-change-this"

# ------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------
# Option A: Local SQLite (Default for testing)
DATABASE_URL="sqlite:///quiz.db"

# Option B: Supabase / PostgreSQL Connection
# Obtain this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Transaction Pooler)
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ------------------------------------------
# GOOGLE GEMINI AI API KEY
# ------------------------------------------
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------
# SMTP EMAIL DELIVERY CONFIGURATION
# ------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="no-reply@eduquizx.com"
EMAILS_FROM_NAME="EduQuizX Examination System"
