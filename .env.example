# ═══════════════════════════════════════════════════════════════════════════
# EduQuizX Unified Environment Configuration Specification
# ═══════════════════════════════════════════════════════════════════════════

# ── 1. Backend Core & Security ──
PROJECT_NAME="EduQuizX - AI Dynamic Examination & Student Management System"
API_V1_STR=/api/v1
SECRET_KEY=change-to-a-secure-random-32-character-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_ORIGINS=*

# ── 2. Database (PostgreSQL / SQLite) ──
# Local SQLite (Development default):
DATABASE_URL=sqlite:///quiz.db

# Render / Managed Cloud PostgreSQL (Production):
# Automatically mapped from Render PostgreSQL database instance or Neon:
# DATABASE_URL=postgresql://eduquizx_user:password@dpg-xxx.render.com/eduquizx?sslmode=require

# ── 3. AI Copilot & Question Generation ──
# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── 4. Email Transmission (Verification & Candidate Passcodes) ──
# Option A: Resend REST API (Recommended for Render — uses HTTPS port 443, never blocked)
RESEND_API_KEY=re_your_resend_api_key_here

# Option B: SendGrid API
SENDGRID_API_KEY=

# Option C: Standard SMTP (Note: Render free tier blocks outbound SMTP ports 465/587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME="EduQuizX Examination System"

# ── 5. Google Identity Services (GIS) / OAuth ──
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── 6. Frontend Service Configuration ──
# Base URL of frontend application for email links (student authorization, password resets):
FRONTEND_URL=https://eduquizx-frontend.onrender.com

# URL of backend API for frontend client requests:
NEXT_PUBLIC_API_URL=https://eduquizx-backend.onrender.com
