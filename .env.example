# ── Unified EduQuizX Environment Configuration Template (Frontend + Backend) ──

# ── Backend AI & Core Settings ──
GEMINI_API_KEY=your_gemini_api_key_here
SECRET_KEY=super-secret-key-change-in-production
FRONTEND_URL=http://localhost:3000

# ── Database Connection ──
# Local SQLite Default:
DATABASE_URL=sqlite:///quiz.db
# PostgreSQL Production Example:
# DATABASE_URL=postgresql://username:password@localhost:5432/eduquizx_db

# ── Frontend API ──
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── SMTP Email Server Configuration ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=EduQuizX Examination System
